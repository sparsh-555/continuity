{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    // **DOM as well as Node, and it is not a mistake.** These files run in Node, but the
    // callbacks handed to `locator.evaluate` are serialised and executed in the browser, so
    // `document` inside one is the page's. Without this they were typed against the outer
    // scope and a spec that builds a long element resolved `document` to a neighbouring
    // variable, or to nothing at all.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // `playwright.config.ts` and the specs run in Node, so they belong to the project that
  // declares node's types. They were in no project at all: `process.env` was flagged in the
  // editor while `bun run build` said nothing, because the build only typechecks what a
  // tsconfig lists — and a file nobody checks is a file that quietly stops compiling.
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
