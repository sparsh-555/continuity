# Copy to .env and fill in. .env is gitignored; .env.example is not.

# Z.ai — https://z.ai/manage-apikey/apikey-list
# Keys are region-locked: a z.ai key does not work against the mainland endpoint.
CONTINUITY_LLM_API_KEY=

# Optional. Defaults to the international endpoint, which is what a z.ai key expects.
# Mainland bigmodel.cn keys need: https://open.bigmodel.cn/api/paas/v4
# CONTINUITY_LLM_BASE_URL=https://api.z.ai/api/paas/v4
# CONTINUITY_LLM_MODEL=glm-5.2

# The database. Local Postgres authenticates by user, so no credentials in the URL.
# Production is named explicitly on the command that needs it — never a default here,
# because a default that points at production is a hazard wearing a configuration file.
DATABASE_URL=postgresql:///continuity_demo

# Replay recorded distributor responses instead of calling the network.
# CONTINUITY_FIXTURES=1
# CONTINUITY_FIXTURE_DIR=fixtures
